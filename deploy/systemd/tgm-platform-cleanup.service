[Unit]
Description=TGM platform system log retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tgm-platform-cleanup
Group=tgm-platform-cleanup
EnvironmentFile=/etc/tgm/platform-cleanup.env
ExecStart=/usr/local/bin/tgm cleanup-platform
TimeoutStartSec=15min
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
