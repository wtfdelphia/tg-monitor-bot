TGM_PROFILE=production
RUST_LOG=info,sqlx=warn
TGM_DB_URL_APP=postgres://app_user:REPLACE_FROM_SECRET@127.0.0.1:6432/tgm
TGM_DB_URL_AUTH=postgres://auth_lookup:REPLACE_FROM_SECRET@127.0.0.1:6432/tgm
TGM_REDIS_URL=redis://127.0.0.1:6379
TGM_KEK_BACKEND=kms
TGM_KMS_KEY_ARN=REPLACE_FROM_SECRET
AWS_CONFIG_FILE=REPLACE_FROM_SECRET
AWS_PROFILE=REPLACE_FROM_SECRET
AWS_EC2_METADATA_DISABLED=true
TGM_DATA_BOT_SECRET_TOKEN=REPLACE_FROM_SECRET
TGM_DATA_BOT_IDENTITY_ID=REPLACE_FROM_SECRET
TGM_BOT_GATEWAY_LISTEN_ADDR=127.0.0.1:8081
