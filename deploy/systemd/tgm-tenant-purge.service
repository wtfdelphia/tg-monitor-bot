[Unit]
Description=TGM deleted tenant physical purge
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tgm-tenant-purge
Group=tgm-tenant-purge
EnvironmentFile=/etc/tgm/tenant-purge.env
ExecStart=/usr/local/bin/tgm purge-deleted-tenants --max-tenants 100
TimeoutStartSec=30min
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
