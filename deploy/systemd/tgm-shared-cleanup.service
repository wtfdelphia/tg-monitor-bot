[Unit]
Description=TGM shared event retention
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tgm-shared-cleanup
Group=tgm-shared-cleanup
EnvironmentFile=/etc/tgm/shared-cleanup.env
ExecStart=/usr/local/bin/tgm cleanup-shared
TimeoutStartSec=15min
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
