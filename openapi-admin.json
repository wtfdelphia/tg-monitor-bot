{
  "openapi": "3.1.0",
  "info": {
    "title": "Telegram Monitor Platform Admin Control Plane",
    "description": "Platform-only contract; tenant routes are intentionally excluded",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "ErrorDetails": {
        "type": "object",
        "properties": {
          "affected_rule_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "existing_id": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ErrorDetails"
              }
            ]
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorEnvelope"
          }
        }
      }
    }
  }
}
